# Copy to .env.local for local development. Never commit real values.
# "public" = safe in the browser bundle; "server" = server-only, never prefix with NEXT_PUBLIC_.

# Supabase project URL and anon (publishable) key. public. Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Service role key. server. Used only to create the account for the admin "Add user" action.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# The site's public origin, used in share links (no trailing slash). public. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (S3 API). server. Cloudflare dashboard > R2 > Manage API tokens (Object Read & Write, one bucket).
R2_ACCOUNT_ID=replace-with-account-id
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret
R2_BUCKET_NAME=projectcv-documents

# Local development and tests only: points R2 at the local mock (scripts/r2-mock.mjs). Leave unset in production.
# R2_ENDPOINT=http://127.0.0.1:4569

# Tests only, optional: use a pre-installed Chromium instead of Playwright's download.
# PW_CHROMIUM_PATH=/path/to/chromium
